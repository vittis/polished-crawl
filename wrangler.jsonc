{
  // Run Wrangler from the monorepo root. The app uses root dev dependencies
  // and local workspaces. See project-notes/DEPLOYMENT.md for GitHub publishing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcss-client",
  "main": "apps/orbrun/worker/index.ts",
  "compatibility_date": "2025-04-01",
  // Package changed app inputs and verify bundled menu recordings.
  "build": {
    "command": "node tools/build/deploy-build.mjs",
    "watch_dir": ["apps/orbrun/src", "packages"]
  },
  "assets": {
    "directory": "apps/orbrun/dist",
    "binding": "ASSETS",
    // the app routes on the path (servers.ts `parseRoute`), so any path that
    // is not an asset is still the app shell
    "not_found_handling": "single-page-application",
    // without this the asset layer answers the proxy routes with index.html
    // and the gamedata loader is handed HTML instead of JavaScript. The rest
    // comes through the Worker too, so an address that is none of the app's
    // says 404 (worker/index.ts answerPage); only the files that are never a
    // page skip it
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/room/*", "!/steam/*", "!/icons/*"]
  },
  // Engine packs and menu recordings are separate static assets of the app Worker.
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "dcss-client-preview",
      "workers_dev": false,
      "preview_urls": false,
      // The existing custom domain is managed in Cloudflare. CI only updates Worker code.
      "vars": { "PREVIEW": true }
    }
  }
}
